{
  "name": "fiber-latch",
  "version": "1.0.0",
  "description": "Backend-only service that turns verified Fiber payments into signed access receipts.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run tests",
    "test:watch": "vitest",
    "fiber:testnet:verify": "tsx scripts/fiber-testnet-verify.ts",
    "demo:local-access": "tsx scripts/demo-local-access.ts",
    "demo:protected-resource": "tsx scripts/demo-protected-resource.ts",
    "demo:live-paid-issuance": "tsx scripts/demo-live-paid-issuance.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "build:access": "npm run build --workspace @fiberlatch/access",
    "lint:access:package": "npm run lint:package --workspace @fiberlatch/access",
    "check:access:types": "npm run check:types --workspace @fiberlatch/access",
    "test:access": "vitest run packages/access/test",
    "test:access:distribution": "npm run test:distribution --workspace @fiberlatch/access",
    "verify:access:package": "npm run test:access && npm run build:access && npm run lint:access:package && npm run check:access:types && npm run test:access:distribution",
    "test:access:example": "npm run test --workspace @fiberlatch/paid-resource-example",
    "demo:access:example": "npm run demo --workspace @fiberlatch/paid-resource-example",
    "verify:access:example": "node examples/paid-resource/scripts/verify-packed.mjs"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "fastify": "^5.0.0",
    "jose": "^5.9.6",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
