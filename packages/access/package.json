{
  "name": "@fiberlatch/access",
  "version": "0.1.0",
  "description": "FiberLatch Access package for signing, verifying, binding, and redeeming host-issued access receipts.",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ticoworld/fiber-latch.git",
    "directory": "packages/access"
  },
  "homepage": "https://github.com/Ticoworld/fiber-latch#readme",
  "bugs": {
    "url": "https://github.com/Ticoworld/fiber-latch/issues"
  },
  "keywords": [
    "fiber",
    "access-control",
    "access-receipt",
    "nodejs",
    "authorization"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module-sync": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint:package": "publint --strict",
    "check:types": "attw --pack . --profile esm-only",
    "test:distribution": "node ./scripts/verify-distribution.mjs",
    "verify": "npm run build && npm run lint:package && npm run check:types && npm run test:distribution"
  },
  "dependencies": {
    "jose": "6.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^22.0.0",
    "publint": "0.3.21",
    "typescript": "^5.7.0"
  }
}
